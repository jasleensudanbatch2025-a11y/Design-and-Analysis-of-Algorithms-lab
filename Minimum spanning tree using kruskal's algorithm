#include <stdio.h>
#include <stdlib.h>
#include <limits.h>



void kruskalMST(int **cost, int V) {

	 int parent[V];
    int edgeNo = 0;
    int minCost = 0;

    // Initialize parent array
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    while (edgeNo < V - 1) {
        int min = INT_MAX;
        int u = -1, v = -1;

        // Find the minimum-weight edge in row-wise order
        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {
                if (cost[i][j] != 9999 &&
                    cost[i][j] < min) {
                    min = cost[i][j];
                    u = i;
                    v = j;
                }
            }
        }

        // Find the root of u
        int rootU = u;
        while (parent[rootU] != rootU) {
            rootU = parent[rootU];
        }

        // Find the root of v
        int rootV = v;
        while (parent[rootV] != rootV) {
            rootV = parent[rootV];
        }

        // Include edge only if it does not form a cycle
        if (rootU != rootV) {
            printf("Edge %d:(%d, %d) cost:%d\n",
                   edgeNo, u, v, min);

            minCost += min;
            parent[rootV] = rootU;
            edgeNo++;
        }

        // Remove this edge from further consideration
        cost[u][v] = 9999;
        cost[v][u] = 9999;
    }

    printf("Minimum cost= %d\n", minCost);
}




int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
